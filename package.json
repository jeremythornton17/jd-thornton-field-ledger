{
  "name": "jd-thornton-field-ledger",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:firestore",
    "test:unit": "node --test tests/inventory-validation.test.mjs",
    "test:firestore:run": "tsx --test tests/inventory-store.emulator.test.ts",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-field-ledger-test \"pnpm run test:firestore:run\"",
    "lint": "eslint . --ignore-pattern .next"
  },
  "dependencies": {
    "firebase": "^12.3.0",
    "firebase-admin": "^13.5.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "^15.26.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
